# Hypha — multi-platform release pipeline.
#
# Triggered when you push a tag matching v*.*.*. GitHub Actions runs three
# parallel jobs (windows-latest / macos-latest / ubuntu-latest), each builds
# the unpacked app, zips/tars it, and uploads to a single GitHub Release.
#
# Once a release is published, every running Hypha desktop instance picks it
# up via update-electron-app on next launch — silent download, applied on
# next restart.
#
# To ship a new version:
#   1. Edit package.json `version` (e.g. 0.1.0 → 0.1.1)
#   2. git commit -am "v0.1.1: <one-line summary>"
#   3. git tag v0.1.1
#   4. git push origin main --tags
#
# That's it. CI handles the rest. ~10-15 minutes per release.

name: release

on:
  push:
    tags:
      - 'v*.*.*'

permissions:
  contents: write   # needed to create releases

jobs:
  build:
    name: build · ${{ matrix.platform }} · ${{ matrix.arch }}
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - { os: windows-latest, platform: win32,  arch: x64,   ext: zip }
          - { os: macos-latest,   platform: darwin, arch: arm64, ext: zip }
          - { os: macos-latest,   platform: darwin, arch: x64,   ext: zip }
          - { os: ubuntu-latest,  platform: linux,  arch: x64,   ext: tar.gz }
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install deps
        run: npm ci

      - name: Pack
        run: node scripts/pack.js --platform=${{ matrix.platform }} --arch=${{ matrix.arch }}

      - name: Archive (Windows / macOS — zip)
        if: matrix.ext == 'zip'
        shell: bash
        run: |
          cd release
          DIR=$(ls -d Hypha-${{ matrix.platform }}-${{ matrix.arch }})
          7z a "../Hypha-${{ matrix.platform }}-${{ matrix.arch }}.zip" "$DIR"
        # 7z is preinstalled on github runners

      - name: Archive (Linux — tar.gz)
        if: matrix.ext == 'tar.gz'
        shell: bash
        run: |
          cd release
          tar -czf "../Hypha-${{ matrix.platform }}-${{ matrix.arch }}.tar.gz" Hypha-${{ matrix.platform }}-${{ matrix.arch }}

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: Hypha-${{ matrix.platform }}-${{ matrix.arch }}
          path: Hypha-${{ matrix.platform }}-${{ matrix.arch }}.${{ matrix.ext }}
          retention-days: 7

  release:
    name: publish release
    needs: build
    runs-on: ubuntu-latest
    steps:
      - name: Checkout (for release notes)
        uses: actions/checkout@v4

      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          path: artifacts

      - name: Flatten artifact tree
        run: find artifacts -type f \( -name '*.zip' -o -name '*.tar.gz' \) -exec mv {} . \;

      - name: Publish GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          name: Hypha ${{ github.ref_name }}
          generate_release_notes: true
          files: |
            Hypha-win32-x64.zip
            Hypha-darwin-arm64.zip
            Hypha-darwin-x64.zip
            Hypha-linux-x64.tar.gz
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
